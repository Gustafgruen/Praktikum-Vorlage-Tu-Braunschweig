\RequirePackage{hyperref}   % Für referenzen
\hypersetup{
    colorlinks=true,    % Links farbig statt Rahmen
    linkcolor=black,     % Farbe interner Links (z.B. Inhaltsverzeichnis)
    filecolor=black,  % Farbe von Datei-Links
    urlcolor=black,      % Farbe externer Links (URLs)
    citecolor=black,    % Farbe von Zitaten
}

